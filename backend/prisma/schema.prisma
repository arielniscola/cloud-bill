generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==================== ENUMS ====================

enum UserRole {
  SUPER_ADMIN
  ADMIN
  SELLER
  WAREHOUSE_CLERK
  FINANCES
  PURCHASES
}

enum TaxCondition {
  RESPONSABLE_INSCRIPTO
  MONOTRIBUTISTA
  EXENTO
  CONSUMIDOR_FINAL
}

enum InvoiceType {
  FACTURA_A
  FACTURA_B
  FACTURA_C
  NOTA_CREDITO_A
  NOTA_CREDITO_B
  NOTA_CREDITO_C
  NOTA_DEBITO_A
  NOTA_DEBITO_B
  NOTA_DEBITO_C
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  AUTHORIZED
  PAID
  CANCELLED
  PARTIALLY_PAID
}

enum MovementType {
  DEBIT
  CREDIT
}

enum StockMovementType {
  PURCHASE
  SALE
  ADJUSTMENT_IN
  ADJUSTMENT_OUT
  TRANSFER_IN
  TRANSFER_OUT
  RETURN
  REMITO_OUT
  RESERVATION
  RESERVATION_RELEASE
}

enum RemitoStatus {
  PENDING
  PARTIALLY_DELIVERED
  DELIVERED
  CANCELLED
}

enum StockBehavior {
  DISCOUNT
  RESERVE
}

enum ActivityAction {
  CREATE
  UPDATE
  DELETE
  PAYMENT
  CANCEL
  TRANSFER
}

enum Currency {
  ARS
  USD
}

enum PurchaseStatus {
  REGISTERED
  CANCELLED
}

enum BudgetStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  CONVERTED
  EXPIRED
  PARTIALLY_PAID
  PAID
}

// ==================== MODELS ====================

model User {
  id                 String   @id @default(uuid())
  username           String   @unique
  email              String?
  password           String
  name               String
  role               UserRole @default(SELLER)
  isActive           Boolean  @default(true)
  companyId          String?
  dashboardShortcuts String? // JSON array de ids de accesos rápidos (NULL = default)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  invoices           Invoice[]
  stockMovements     StockMovement[]
  remitos            Remito[]
  activityLogs       ActivityLog[]
  purchases          Purchase[]
  cashRegisterCloses CashRegisterClose[]
  budgets            Budget[]
  recibos            Recibo[]
  ordenPedidos       OrdenPedido[]
  ordenCompras       OrdenCompra[]
  ordenPagos         OrdenPago[]
  recurringInvoices  RecurringInvoice[]

  @@map("users")
}

model Customer {
  id            String       @id @default(uuid())
  name          String
  taxId         String? // CUIT/CUIL — único POR EMPRESA (ver @@unique abajo)
  taxCondition  TaxCondition @default(CONSUMIDOR_FINAL)
  saleCondition String       @default("CONTADO") // CONTADO | CUENTA_CORRIENTE
  address       String?
  city          String?
  province      String?
  postalCode    String?
  phone         String?
  email         String?
  notes         String?
  isActive      Boolean      @default(true)
  companyId     String       @default("00000000-0000-0000-0000-000000000001")
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  invoices          Invoice[]
  currentAccounts   CurrentAccount[]
  remitos           Remito[]
  budgets           Budget[]
  recibos           Recibo[]
  ordenPedidos      OrdenPedido[]
  recurringInvoices RecurringInvoice[]

  // Un mismo CUIT puede ser cliente de varias empresas del sistema: la
  // unicidad es por empresa, no global (igual que el SKU de productos).
  @@unique([companyId, taxId], map: "customers_company_taxid_key")
  @@index([companyId, name], map: "idx_customers_company_name")
  @@map("customers")
}

model Rubro {
  id        String   @id @default(uuid())
  name      String
  parentId  String?
  companyId String   @default("00000000-0000-0000-0000-000000000001")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  parent   Rubro?    @relation("RubroHierarchy", fields: [parentId], references: [id])
  children Rubro[]   @relation("RubroHierarchy")
  products Product[]

  @@map("rubros")
}

model Brand {
  id        String   @id @default(uuid())
  name      String
  isActive  Boolean  @default(true)
  companyId String   @default("00000000-0000-0000-0000-000000000001")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products Product[]

  @@map("brands")
}

model Category {
  id             String   @id @default(uuid())
  name           String
  description    String?
  isActive       Boolean  @default(true)
  allowsVariants Boolean  @default(false)
  companyId      String   @default("00000000-0000-0000-0000-000000000001")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  products Product[]

  @@map("categories")
}

model Product {
  id             String    @id @default(uuid())
  sku            String
  name           String
  description    String?
  rubroId        String?
  brandId        String?
  categoryId     String?
  supplierId     String? // Proveedor habitual — para filtrar el catálogo por proveedor
  barcode        String?
  unit           String?   @default("UN")
  internalNotes  String?
  cost           Decimal   @db.Decimal(12, 2)
  price          Decimal   @db.Decimal(12, 2)
  salePriceUSD   Decimal?  @db.Decimal(12, 2) // Precio de venta en USD (opcional, para presupuestos)
  taxRate        Decimal   @default(21) @db.Decimal(5, 2)
  leadTimeDays   Int? // Días de reposición para predicción de quiebre
  imageUrl       String? // URL pública de la imagen — módulo "imagenes"
  imageKey       String? // Key del objeto en el bucket, necesaria para borrarlo
  trackStock     Boolean   @default(true) // false = producto no inventariado (servicios): no genera/valida stock
  priceUpdatedAt DateTime? // Última vez que se actualizó price, cost o salePriceUSD
  isActive       Boolean   @default(true)
  companyId      String    @default("00000000-0000-0000-0000-000000000001")
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  rubro                 Rubro?                    @relation(fields: [rubroId], references: [id])
  brand                 Brand?                    @relation(fields: [brandId], references: [id])
  category              Category?                 @relation(fields: [categoryId], references: [id])
  supplier              Supplier?                 @relation(fields: [supplierId], references: [id])
  invoiceItems          InvoiceItem[]
  stocks                Stock[]
  stockMovements        StockMovement[]
  remitoItems           RemitoItem[]
  purchaseItems         PurchaseItem[]
  budgetItems           BudgetItem[]
  ordenPedidoItems      OrdenPedidoItem[]
  ordenCompraItems      OrdenCompraItem[]
  customFieldValues     ProductCustomFieldValue[]
  variants              ProductVariant[]
  recurringInvoiceItems RecurringInvoiceItem[]

  @@unique([companyId, sku])
  @@index([companyId, isActive], map: "idx_products_company_active")
  @@map("products")
}

model ProductVariant {
  id            String   @id @default(uuid())
  productId     String
  sku           String
  name          String
  attributes    Json     @default("{}")
  priceOverride Decimal? @db.Decimal(12, 2)
  costOverride  Decimal? @db.Decimal(12, 2)
  barcode       String?
  isActive      Boolean  @default(true)
  companyId     String   @default("00000000-0000-0000-0000-000000000001")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  product          Product           @relation(fields: [productId], references: [id], onDelete: Cascade)
  stocks           Stock[]
  stockMovements   StockMovement[]
  purchaseItems    PurchaseItem[]
  invoiceItems     InvoiceItem[]
  budgetItems      BudgetItem[]
  ordenPedidoItems OrdenPedidoItem[]
  remitoItems      RemitoItem[]

  @@unique([companyId, sku])
  @@index([productId])
  @@map("product_variants")
}

model ProductCustomField {
  id         String   @id @default(uuid())
  name       String
  key        String
  type       String   @default("TEXT") // TEXT | NUMBER | DATE | BOOLEAN | SELECT
  options    String? // CSV options for SELECT type
  isRequired Boolean  @default(false)
  order      Int      @default(0)
  isActive   Boolean  @default(true)
  companyId  String   @default("00000000-0000-0000-0000-000000000001")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  values ProductCustomFieldValue[]

  @@unique([companyId, key])
  @@map("product_custom_fields")
}

model ProductCustomFieldValue {
  id        String   @id @default(uuid())
  productId String
  fieldId   String
  value     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product Product            @relation(fields: [productId], references: [id], onDelete: Cascade)
  field   ProductCustomField @relation(fields: [fieldId], references: [id], onDelete: Cascade)

  @@unique([productId, fieldId])
  @@map("product_custom_field_values")
}

model Invoice {
  id                 String        @id @default(uuid())
  type               InvoiceType
  number             String
  customerId         String
  userId             String
  date               DateTime      @default(now())
  dueDate            DateTime?
  subtotal           Decimal       @db.Decimal(12, 2)
  taxAmount          Decimal       @db.Decimal(12, 2)
  total              Decimal       @db.Decimal(12, 2)
  currency           Currency      @default(ARS)
  exchangeRate       Decimal       @default(1) @db.Decimal(12, 4)
  status             InvoiceStatus @default(DRAFT)
  notes              String?
  paymentTerms       String?
  saleCondition      String        @default("CONTADO") // CONTADO | CUENTA_CORRIENTE
  stockBehavior      String        @default("DISCOUNT") // DISCOUNT | RESERVE
  originInvoiceId    String? // FK to origin invoice (for NC/ND)
  ordenPedidoId      String? // Set when created from an OrdenPedido
  warehouseId        String? // Depósito de stock (NULL = por defecto)
  recurringInvoiceId String? // Abono que generó esta factura
  cae                String?
  caeExpiry          DateTime?
  afipPtVenta        Int?
  afipCbtNum         Int?
  afipObservaciones  String? // Observaciones/advertencias devueltas por ARCA al emitir
  companyId          String        @default("00000000-0000-0000-0000-000000000001")
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  customer         Customer          @relation(fields: [customerId], references: [id])
  user             User              @relation(fields: [userId], references: [id])
  warehouse        Warehouse?        @relation(fields: [warehouseId], references: [id], onDelete: SetNull)
  originInvoice    Invoice?          @relation("InvoiceOrigin", fields: [originInvoiceId], references: [id], onDelete: SetNull)
  creditDebitNotes Invoice[]         @relation("InvoiceOrigin")
  recurringInvoice RecurringInvoice? @relation(fields: [recurringInvoiceId], references: [id], onDelete: SetNull)
  items            InvoiceItem[]
  accountMovements AccountMovement[]
  budgets          Budget[]
  remitos          Remito[]
  recibos          Recibo[]
  ordenPedidos     OrdenPedido[]     @relation("InvoiceOrdenPedido")

  fiscalMode String @default("FORMAL")

  @@unique([companyId, number])
  @@index([fiscalMode], map: "idx_invoices_fiscalMode")
  @@index([companyId, date(sort: Desc)], map: "idx_invoices_company_date")
  @@index([companyId, status], map: "idx_invoices_company_status")
  @@index([customerId, status], map: "idx_invoices_customer_status")
  @@map("invoices")
}

model InvoiceItem {
  id          String  @id @default(uuid())
  invoiceId   String
  productId   String
  variantId   String?
  quantity    Decimal @db.Decimal(10, 2)
  unitPrice   Decimal @db.Decimal(12, 2)
  discountPct Decimal @default(0) @db.Decimal(12, 8)
  taxRate     Decimal @db.Decimal(5, 2)
  subtotal    Decimal @db.Decimal(12, 2)
  taxAmount   Decimal @db.Decimal(12, 2)
  total       Decimal @db.Decimal(12, 2)

  invoice Invoice         @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  product Product         @relation(fields: [productId], references: [id])
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([variantId])
  @@map("invoice_items")
}

// ── Facturación recurrente (abonos) ─────────────────────────────────────────
// Plantilla que genera facturas en borrador según una frecuencia. La emisión
// (stock/CC/ARCA) sigue siendo una acción del usuario sobre cada borrador.
model RecurringInvoice {
  id               String      @id @default(uuid())
  name             String
  customerId       String
  userId           String
  type             InvoiceType @default(FACTURA_B)
  currency         Currency    @default(ARS)
  exchangeRate     Decimal     @default(1) @db.Decimal(12, 4)
  saleCondition    String      @default("CONTADO")
  paymentTerms     String?
  stockBehavior    String      @default("DISCOUNT")
  warehouseId      String?
  notes            String?
  frequency        String      @default("MONTHLY") // WEEKLY|MONTHLY|BIMONTHLY|QUARTERLY|SEMIANNUAL|YEARLY
  dayOfMonth       Int? // 1-28 (para frecuencias mensuales o mayores)
  useCurrentPrices Boolean     @default(false) // true = precio de lista del producto al generar
  startDate        DateTime
  endDate          DateTime?
  nextRunAt        DateTime
  lastRunAt        DateTime?
  generatedCount   Int         @default(0)
  isActive         Boolean     @default(true)
  companyId        String      @default("00000000-0000-0000-0000-000000000001")
  fiscalMode       String      @default("FORMAL")
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  customer          Customer               @relation(fields: [customerId], references: [id])
  user              User                   @relation(fields: [userId], references: [id])
  warehouse         Warehouse?             @relation(fields: [warehouseId], references: [id], onDelete: SetNull)
  items             RecurringInvoiceItem[]
  generatedInvoices Invoice[]

  @@index([nextRunAt], map: "idx_recurring_invoices_nextRunAt")
  @@index([companyId], map: "idx_recurring_invoices_companyId")
  @@map("recurring_invoices")
}

model RecurringInvoiceItem {
  id                 String  @id @default(uuid())
  recurringInvoiceId String
  productId          String
  variantId          String?
  quantity           Decimal @db.Decimal(10, 2)
  unitPrice          Decimal @db.Decimal(12, 2)
  discountPct        Decimal @default(0) @db.Decimal(12, 8)
  taxRate            Decimal @default(21) @db.Decimal(5, 2)

  recurringInvoice RecurringInvoice @relation(fields: [recurringInvoiceId], references: [id], onDelete: Cascade)
  product          Product          @relation(fields: [productId], references: [id])

  @@map("recurring_invoice_items")
}

model CurrentAccount {
  id          String   @id @default(uuid())
  customerId  String
  currency    Currency @default(ARS)
  balance     Decimal  @default(0) @db.Decimal(12, 2)
  creditLimit Decimal? @db.Decimal(12, 2)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  customer  Customer          @relation(fields: [customerId], references: [id])
  movements AccountMovement[]

  fiscalMode String @default("FORMAL")

  @@unique([customerId, currency, fiscalMode], map: "current_accounts_customerId_currency_fiscalMode_key")
  @@map("current_accounts")
}

model AccountMovement {
  id               String       @id @default(uuid())
  currentAccountId String
  type             MovementType
  amount           Decimal      @db.Decimal(12, 2)
  balance          Decimal      @db.Decimal(12, 2) // Balance after movement
  description      String
  invoiceId        String?
  budgetId         String?
  ordenPedidoId    String?
  cashRegisterId   String? // Only for payment movements
  reciboId         String?      @unique
  createdAt        DateTime     @default(now())

  currentAccount CurrentAccount @relation(fields: [currentAccountId], references: [id])
  invoice        Invoice?       @relation(fields: [invoiceId], references: [id])
  budget         Budget?        @relation(fields: [budgetId], references: [id])
  ordenPedido    OrdenPedido?   @relation(fields: [ordenPedidoId], references: [id])
  cashRegister   CashRegister?  @relation(fields: [cashRegisterId], references: [id])
  recibo         Recibo?        @relation(fields: [reciboId], references: [id])

  fiscalMode String @default("FORMAL")

  @@index([fiscalMode], map: "idx_account_movements_fiscal")
  @@index([currentAccountId, createdAt(sort: Desc)], map: "idx_account_movements_account_created")
  @@map("account_movements")
}

model CashRegister {
  id          String   @id @default(uuid())
  name        String
  description String?
  isActive    Boolean  @default(true)
  companyId   String   @default("00000000-0000-0000-0000-000000000001")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  accountMovements      AccountMovement[]
  closes                CashRegisterClose[]
  appSettingsBudget     AppSettings[]       @relation("AppSettingsBudgetCR")
  appSettingsInvoice    AppSettings[]       @relation("AppSettingsInvoiceCR")
  recibos               Recibo[]
  ordenPedidosCashReg   OrdenPedido[]       @relation("OrdenPedidoCashRegister")
  ordenPedidosInvoiceCR OrdenPedido[]       @relation("OrdenPedidoInvoiceCashRegister")
  ordenPagos            OrdenPago[]

  @@map("cash_registers")
}

model CashRegisterClose {
  id             String    @id @default(uuid())
  cashRegisterId String
  closedAt       DateTime  @default(now())
  fromDate       DateTime?
  totalIn        Decimal   @db.Decimal(12, 2)
  totalOut       Decimal   @db.Decimal(12, 2)
  netTotal       Decimal   @db.Decimal(12, 2)
  movementsCount Int
  notes          String?
  userId         String?
  createdAt      DateTime  @default(now())

  cashRegister CashRegister @relation(fields: [cashRegisterId], references: [id])
  user         User?        @relation(fields: [userId], references: [id])

  @@map("cash_register_closes")
}

model Warehouse {
  id        String   @id @default(uuid())
  name      String
  address   String?
  isDefault Boolean  @default(false)
  isActive  Boolean  @default(true)
  companyId String   @default("00000000-0000-0000-0000-000000000001")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  stocks            Stock[]
  stockMovements    StockMovement[]
  purchases         Purchase[]
  ordenCompras      OrdenCompra[]
  invoices          Invoice[]
  ordenPedidos      OrdenPedido[]
  recurringInvoices RecurringInvoice[]

  @@map("warehouses")
}

model Stock {
  id               String   @id @default(uuid())
  productId        String
  variantId        String?
  warehouseId      String
  quantity         Decimal  @default(0) @db.Decimal(10, 2)
  reservedQuantity Decimal  @default(0) @db.Decimal(10, 2)
  minQuantity      Decimal? @db.Decimal(10, 2) // Alert threshold
  updatedAt        DateTime @updatedAt

  product   Product         @relation(fields: [productId], references: [id])
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)
  warehouse Warehouse       @relation(fields: [warehouseId], references: [id])

  // NOTA: a nivel DB el unique real es partial (variantId IS NULL / IS NOT NULL).
  // Esta @@unique se mantiene en schema.prisma para que el cliente Prisma generado
  // siga exponiendo `productId_warehouseId` y los controllers de Invoice/Budget/Remito
  // existentes (no variant-aware) sigan compilando. Para productos sin variantes
  // funciona correctamente porque solo existe una fila por (productId, warehouseId, variantId=null).
  @@unique([productId, warehouseId])
  @@index([variantId])
  @@map("stocks")
}

model StockMovement {
  id                 String            @id @default(uuid())
  productId          String
  variantId          String?
  warehouseId        String
  type               StockMovementType
  quantity           Decimal           @db.Decimal(10, 2)
  previousQuantity   Decimal           @db.Decimal(10, 2)
  newQuantity        Decimal           @db.Decimal(10, 2)
  reason             String?
  referenceId        String? // Invoice ID or Transfer ID
  userId             String?
  relatedWarehouseId String? // For transfers
  createdAt          DateTime          @default(now())

  product   Product         @relation(fields: [productId], references: [id])
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  warehouse Warehouse       @relation(fields: [warehouseId], references: [id])
  user      User?           @relation(fields: [userId], references: [id])

  fiscalMode String @default("FORMAL")

  @@index([fiscalMode], map: "idx_stock_movements_fiscal")
  @@index([variantId])
  @@index([productId, createdAt(sort: Desc)], map: "idx_stock_movements_product_created")
  @@index([warehouseId, createdAt(sort: Desc)], map: "idx_stock_movements_warehouse_created")
  @@map("stock_movements")
}

model Remito {
  id            String        @id @default(uuid())
  number        String
  customerId    String
  userId        String
  invoiceId     String?
  budgetId      String?
  ordenPedidoId String?
  date          DateTime      @default(now())
  status        RemitoStatus  @default(PENDING)
  stockBehavior StockBehavior
  notes         String?
  companyId     String        @default("00000000-0000-0000-0000-000000000001")
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  customer    Customer     @relation(fields: [customerId], references: [id])
  user        User         @relation(fields: [userId], references: [id])
  invoice     Invoice?     @relation(fields: [invoiceId], references: [id])
  budget      Budget?      @relation(fields: [budgetId], references: [id])
  ordenPedido OrdenPedido? @relation(fields: [ordenPedidoId], references: [id])
  items       RemitoItem[]

  fiscalMode String @default("FORMAL")

  @@unique([companyId, number])
  @@index([companyId, date(sort: Desc)], map: "idx_remitos_company_date")
  @@map("remitos")
}

model RemitoItem {
  id                String  @id @default(uuid())
  remitoId          String
  productId         String
  variantId         String?
  quantity          Decimal @db.Decimal(10, 2)
  deliveredQuantity Decimal @default(0) @db.Decimal(10, 2)

  remito  Remito          @relation(fields: [remitoId], references: [id], onDelete: Cascade)
  product Product         @relation(fields: [productId], references: [id])
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([variantId])
  @@map("remito_items")
}

model ActivityLog {
  id          String         @id @default(uuid())
  userId      String
  action      ActivityAction
  entity      String
  entityId    String
  description String
  metadata    Json?
  createdAt   DateTime       @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([entity])
  @@index([createdAt])
  @@map("activity_logs")
}

model AfipConfig {
  id                String    @id @default(uuid())
  companyId         String    @default("00000000-0000-0000-0000-000000000001")
  cuit              String
  salePoint         Int
  businessName      String?
  businessAddress   String?
  taxCondition      String?
  activityStartDate DateTime?
  grossIncome          String?  // Nro. de Ingresos Brutos del emisor (impresión fiscal)
  consumerDefensePhone String?  // Tel. de Defensa del Consumidor provincial (impresión fiscal)
  cert              String    @db.Text
  privateKey        String    @db.Text
  isProduction      Boolean   @default(false)
  isActive          Boolean   @default(true)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@map("afip_config")
}

model Supplier {
  id           String       @id @default(uuid())
  name         String
  cuit         String? // único POR EMPRESA (ver @@unique abajo)
  taxCondition TaxCondition @default(RESPONSABLE_INSCRIPTO)
  address      String?
  city         String?
  phone        String?
  email        String?
  notes        String?
  isActive     Boolean      @default(true)
  companyId    String       @default("00000000-0000-0000-0000-000000000001")
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  // Retención automática (ej. IIBB 1.5%) — se autocompleta al cargar una
  // factura de este proveedor. NULL/0 = sin retención automática.
  retentionType       String?
  retentionPercentage Decimal? @db.Decimal(5, 2)

  purchases                Purchase[]
  ordenCompras             OrdenCompra[]
  ordenPagos               OrdenPago[]
  supplierAccountMovements SupplierAccountMovement[]
  purchaseInvoices         PurchaseInvoice[]
  products                 Product[]
  retentions               SupplierRetention[]

  // Un mismo proveedor le vende a varias empresas: unicidad por empresa.
  @@unique([companyId, cuit], map: "suppliers_company_cuit_key")
  @@index([companyId, name], map: "idx_suppliers_company_name")
  @@map("suppliers")
}

// Retenciones configuradas para un proveedor. Se practican al PAGAR (ver
// OrdenPagoRetencion), no al cargar la factura: la Orden de Pago las propone
// automáticamente calculando `percentage` sobre la base elegida.
//   NETO  → suma de subtotales de las facturas pagadas (sin IVA)
//   IVA   → suma del IVA de esas facturas
//   BRUTO → total de las facturas (neto + IVA)
// Acceso vía $queryRaw/$executeRaw (el cliente Prisma puede estar desactualizado).
model SupplierRetention {
  id           String   @id @default(uuid())
  supplierId   String
  companyId    String
  type         String   @default("IIBB") // IIBB | GANANCIAS | IVA | SUSS | OTHER
  jurisdiction String?
  base         String   @default("NETO") // NETO | IVA | BRUTO
  percentage   Decimal  @default(0) @db.Decimal(6, 3)
  arcaImpuesto String? // código de impuesto SICORE (217 Ganancias, 767 IVA)
  arcaRegimen  String? // código de régimen SICORE (según la actividad)
  isActive     Boolean  @default(true)
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  supplier   Supplier             @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  ordenPagos OrdenPagoRetencion[]

  @@index([supplierId])
  @@index([companyId])
  @@map("supplier_retentions")
}

model Purchase {
  id           String         @id @default(uuid())
  type         InvoiceType
  number       String
  supplierId   String
  userId       String
  warehouseId  String? // Optional: warehouse where stock is received
  date         DateTime       @default(now())
  subtotal     Decimal        @db.Decimal(12, 2)
  taxAmount    Decimal        @db.Decimal(12, 2)
  total        Decimal        @db.Decimal(12, 2)
  currency     Currency       @default(ARS)
  exchangeRate Decimal        @default(1) @db.Decimal(12, 4) // Cotización USD → ARS (editable)
  status       PurchaseStatus @default(REGISTERED)
  notes        String?
  companyId    String         @default("00000000-0000-0000-0000-000000000001")
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  paymentStatus    String  @default("PENDING") // PENDING | PARTIALLY_PAID | PAID
  paidAmount       Decimal @default(0) @db.Decimal(12, 2)
  saleCondition    String  @default("CONTADO") // CONTADO | CUENTA_CORRIENTE
  originPurchaseId String? // FK to origin purchase (for NC/ND)

  supplier                 Supplier                  @relation(fields: [supplierId], references: [id])
  user                     User                      @relation(fields: [userId], references: [id])
  warehouse                Warehouse?                @relation(fields: [warehouseId], references: [id])
  items                    PurchaseItem[]
  ordenCompra              OrdenCompra?
  ordenPagoItems           OrdenPagoItem[]
  supplierAccountMovements SupplierAccountMovement[]
  supplierInvoices         PurchaseInvoice[]
  originPurchase           Purchase?                 @relation("PurchaseOrigin", fields: [originPurchaseId], references: [id], onDelete: SetNull)
  creditDebitNotes         Purchase[]                @relation("PurchaseOrigin")

  fiscalMode String @default("FORMAL")

  @@index([fiscalMode], map: "idx_purchases_fiscalMode")
  @@index([companyId, date(sort: Desc)], map: "idx_purchases_company_date")
  @@index([supplierId, status], map: "idx_purchases_supplier_status")
  @@map("purchases")
}

model Budget {
  id            String       @id @default(uuid())
  number        String
  type          InvoiceType  @default(FACTURA_B)
  customerId    String?
  userId        String
  date          DateTime     @default(now())
  validUntil    DateTime?
  subtotal      Decimal      @db.Decimal(12, 2)
  taxAmount     Decimal      @db.Decimal(12, 2)
  total         Decimal      @db.Decimal(12, 2)
  currency      Currency     @default(ARS)
  exchangeRate  Decimal      @default(1) @db.Decimal(12, 4)
  status        BudgetStatus @default(DRAFT)
  notes         String?
  paymentTerms  String?
  saleCondition String       @default("CONTADO") // CONTADO | CUENTA_CORRIENTE
  stockBehavior String       @default("DISCOUNT") // DISCOUNT | RESERVE
  invoiceId     String? // Set when converted to invoice
  companyId     String       @default("00000000-0000-0000-0000-000000000001")
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  customer         Customer?         @relation(fields: [customerId], references: [id])
  user             User              @relation(fields: [userId], references: [id])
  invoice          Invoice?          @relation(fields: [invoiceId], references: [id])
  items            BudgetItem[]
  remitos          Remito[]
  recibos          Recibo[]
  accountMovements AccountMovement[]
  ordenPedidos     OrdenPedido[]     @relation("BudgetOrdenPedido")

  fiscalMode String @default("FORMAL")

  @@unique([companyId, number])
  @@index([companyId, date(sort: Desc)], map: "idx_budgets_company_date")
  @@map("budgets")
}

model BudgetItem {
  id          String  @id @default(uuid())
  budgetId    String
  productId   String?
  variantId   String?
  description String
  quantity    Decimal @db.Decimal(10, 2)
  unitPrice   Decimal @db.Decimal(12, 2)
  taxRate     Decimal @db.Decimal(5, 2)
  subtotal    Decimal @db.Decimal(12, 2)
  taxAmount   Decimal @db.Decimal(12, 2)
  total       Decimal @db.Decimal(12, 2)

  budget  Budget          @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  product Product?        @relation(fields: [productId], references: [id])
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([variantId])
  @@map("budget_items")
}

model AppSettings {
  id                           String   @id @default("default")
  defaultBudgetCashRegisterId  String?
  defaultInvoiceCashRegisterId String?
  deadStockDays                Int      @default(90) // Días sin ventas para considerar producto muerto
  safetyStockDays              Int      @default(14) // Días de stock de seguridad para recomendaciones
  companyTaxCondition          String   @default("RESPONSABLE_INSCRIPTO")
  printFormatInvoice           String   @default("A4")
  printFormatBudget            String   @default("A4")
  printFormatOrdenPedido       String   @default("THERMAL_80MM")
  printFormatRemito            String   @default("A4")
  printFormatRecibo            String   @default("A4")
  createdAt                    DateTime @default(now())
  updatedAt                    DateTime @updatedAt

  defaultBudgetCashRegister  CashRegister? @relation("AppSettingsBudgetCR", fields: [defaultBudgetCashRegisterId], references: [id])
  defaultInvoiceCashRegister CashRegister? @relation("AppSettingsInvoiceCR", fields: [defaultInvoiceCashRegisterId], references: [id])

  @@map("app_settings")
}

model PurchaseItem {
  id          String  @id @default(uuid())
  purchaseId  String
  productId   String? // Optional: link to product for stock tracking
  variantId   String?
  description String
  quantity    Decimal @db.Decimal(10, 2)
  unitPrice   Decimal @db.Decimal(12, 2)
  taxRate     Decimal @db.Decimal(5, 2)
  subtotal    Decimal @db.Decimal(12, 2)
  taxAmount   Decimal @db.Decimal(12, 2)
  total       Decimal @db.Decimal(12, 2)

  purchase Purchase        @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  product  Product?        @relation(fields: [productId], references: [id])
  variant  ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([variantId])
  @@map("purchase_items")
}

model PurchaseInvoice {
  id            String    @id @default(uuid())
  purchaseId    String? // legacy: vínculo a la compra (retirada del flujo)
  supplierId    String? // documento de primer nivel: proveedor propio
  number        String
  type          String    @default("FACTURA_A")
  subtotal      Decimal   @default(0) @db.Decimal(12, 2)
  taxRate       Decimal   @default(21) @db.Decimal(5, 2)
  taxAmount     Decimal   @default(0) @db.Decimal(12, 2)
  amount        Decimal   @db.Decimal(12, 2) // total (subtotal + taxAmount)
  currency      String    @default("ARS")
  exchangeRate  Decimal   @default(1) @db.Decimal(12, 4)
  saleCondition String    @default("CONTADO") // CONTADO | CUENTA_CORRIENTE
  date          DateTime  @default(now())
  dueDate       DateTime?
  paymentMethod String    @default("BANK_TRANSFER")
  status        String    @default("PENDING") // PENDING | PAID
  notes         String?
  companyId     String    @default("00000000-0000-0000-0000-000000000001")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  originInvoiceId String? // NC/ND → factura de compra de origen

  purchase         Purchase?         @relation(fields: [purchaseId], references: [id], onDelete: SetNull)
  supplier         Supplier?         @relation(fields: [supplierId], references: [id])
  ordenPagoItems   OrdenPagoItem[]
  originInvoice    PurchaseInvoice?  @relation("PurchaseInvoiceOrigin", fields: [originInvoiceId], references: [id], onDelete: SetNull)
  creditDebitNotes PurchaseInvoice[] @relation("PurchaseInvoiceOrigin")

  fiscalMode String @default("FORMAL")

  @@index([supplierId])
  @@index([companyId, date(sort: Desc)], map: "idx_purchase_invoices_company_date")
  @@index([supplierId, status], map: "idx_purchase_invoices_supplier_status")
  @@map("purchase_invoices")
}

model Recibo {
  id     String   @id @default(cuid())
  number String // REC-YYYY-XXXXXXXX
  date   DateTime @default(now())

  invoiceId     String?
  invoice       Invoice?     @relation(fields: [invoiceId], references: [id])
  budgetId      String?
  budget        Budget?      @relation(fields: [budgetId], references: [id])
  ordenPedidoId String?
  ordenPedido   OrdenPedido? @relation(fields: [ordenPedidoId], references: [id])

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])
  userId     String
  user       User     @relation(fields: [userId], references: [id])

  cashRegisterId String?
  cashRegister   CashRegister? @relation(fields: [cashRegisterId], references: [id])

  amount       Decimal @db.Decimal(12, 2)
  currency     String  @default("ARS")
  exchangeRate Decimal @default(1) @db.Decimal(12, 4) // Cotización usada (para USD → ARS)

  paymentMethod String // CASH | BANK_TRANSFER | CHECK | CARD
  reference     String? // N° referencia (transferencia), N° cheque, últimos 4 dígitos tarjeta
  bank          String? // Banco (para cheques/transferencias)
  checkDueDate  DateTime? // Vencimiento cheque
  installments  Int? // Cuotas (tarjeta)

  cardId           String?
  card             Card?    @relation(fields: [cardId], references: [id])
  surchargePercent Decimal? @db.Decimal(5, 2)
  surchargeAmount  Decimal? @db.Decimal(12, 2)

  notes       String?
  status      String  @default("EMITTED") // EMITTED | CANCELLED
  checkStatus String? // PENDING | DEPOSITED | CLEARED | BOUNCED | RETURNED (only for CHECK)
  companyId   String  @default("00000000-0000-0000-0000-000000000001")

  accountMovement AccountMovement?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  fiscalMode String @default("FORMAL")

  @@unique([companyId, number])
  @@index([fiscalMode], map: "idx_recibos_fiscalMode")
  @@index([companyId, date(sort: Desc)], map: "idx_recibos_company_date")
  @@map("recibos")
}

model OrdenPedido {
  id                    String    @id @default(uuid())
  number                String
  customerId            String?
  userId                String
  date                  DateTime  @default(now())
  dueDate               DateTime?
  subtotal              Decimal   @db.Decimal(12, 2)
  taxAmount             Decimal   @db.Decimal(12, 2)
  total                 Decimal   @db.Decimal(12, 2)
  currency              Currency  @default(ARS)
  exchangeRate          Decimal   @default(1) @db.Decimal(12, 4)
  status                String    @default("DRAFT")
  notes                 String?
  paymentTerms          String?
  saleCondition         String    @default("CONTADO")
  stockBehavior         String    @default("DISCOUNT")
  invoiceId             String?
  cashRegisterId        String?
  invoiceCashRegisterId String?
  warehouseId           String? // Depósito de stock (NULL = por defecto)
  budgetId              String? // Presupuesto de origen (trazabilidad)
  // UUID que genera el navegador para una venta cargada sin conexión. Viaja
  // como Idempotency-Key: es lo que evita duplicar la venta si un reintento
  // se superpone con un envío que sí había llegado. NULL en las ventas online.
  clientUuid            String?   @unique
  companyId             String    @default("00000000-0000-0000-0000-000000000001")
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  customer            Customer?         @relation(fields: [customerId], references: [id])
  user                User              @relation(fields: [userId], references: [id])
  warehouse           Warehouse?        @relation(fields: [warehouseId], references: [id], onDelete: SetNull)
  budget              Budget?           @relation("BudgetOrdenPedido", fields: [budgetId], references: [id], onDelete: SetNull)
  invoice             Invoice?          @relation("InvoiceOrdenPedido", fields: [invoiceId], references: [id])
  cashRegister        CashRegister?     @relation("OrdenPedidoCashRegister", fields: [cashRegisterId], references: [id])
  invoiceCashRegister CashRegister?     @relation("OrdenPedidoInvoiceCashRegister", fields: [invoiceCashRegisterId], references: [id])
  items               OrdenPedidoItem[]
  remitos             Remito[]
  recibos             Recibo[]
  accountMovements    AccountMovement[]

  fiscalMode String @default("FORMAL")

  @@unique([companyId, number])
  @@index([companyId, date(sort: Desc)], map: "idx_orden_pedidos_company_date")
  @@map("orden_pedidos")
}

model OrdenCompra {
  id           String    @id @default(uuid())
  number       String // OC-YYYY-XXXX
  supplierId   String
  userId       String
  date         DateTime  @default(now())
  expectedDate DateTime? // Fecha esperada de entrega
  subtotal     Decimal   @db.Decimal(12, 2)
  taxAmount    Decimal   @db.Decimal(12, 2)
  total        Decimal   @db.Decimal(12, 2)
  currency     Currency  @default(ARS)
  exchangeRate Decimal   @default(1) @db.Decimal(12, 4)
  status       String    @default("DRAFT") // DRAFT|SENT|CONFIRMED|RECEIVED|CANCELLED
  warehouseId  String? // Almacén destino al recibir
  notes        String?
  purchaseId   String?   @unique // Set when converted to Purchase
  companyId    String    @default("00000000-0000-0000-0000-000000000001")
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  supplier  Supplier          @relation(fields: [supplierId], references: [id])
  user      User              @relation(fields: [userId], references: [id])
  warehouse Warehouse?        @relation(fields: [warehouseId], references: [id])
  purchase  Purchase?         @relation(fields: [purchaseId], references: [id])
  items     OrdenCompraItem[]

  fiscalMode String @default("FORMAL")

  @@unique([companyId, number])
  @@map("orden_compras")
}

model OrdenCompraItem {
  id            String  @id @default(uuid())
  ordenCompraId String
  productId     String?
  description   String
  quantity      Decimal @db.Decimal(10, 2)
  unitPrice     Decimal @db.Decimal(12, 2)
  taxRate       Decimal @db.Decimal(5, 2)
  subtotal      Decimal @db.Decimal(12, 2)
  taxAmount     Decimal @db.Decimal(12, 2)
  total         Decimal @db.Decimal(12, 2)

  ordenCompra OrdenCompra @relation(fields: [ordenCompraId], references: [id], onDelete: Cascade)
  product     Product?    @relation(fields: [productId], references: [id])

  @@map("orden_compra_items")
}

model OrdenPedidoItem {
  id            String  @id @default(uuid())
  ordenPedidoId String
  productId     String?
  variantId     String?
  description   String
  quantity      Decimal @db.Decimal(10, 2)
  unitPrice     Decimal @db.Decimal(12, 2)
  discountPct   Decimal @default(0) @db.Decimal(12, 8)
  taxRate       Decimal @db.Decimal(5, 2)
  subtotal      Decimal @db.Decimal(12, 2)
  taxAmount     Decimal @db.Decimal(12, 2)
  total         Decimal @db.Decimal(12, 2)

  ordenPedido OrdenPedido     @relation(fields: [ordenPedidoId], references: [id], onDelete: Cascade)
  product     Product?        @relation(fields: [productId], references: [id])
  variant     ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([variantId])
  @@map("orden_pedido_items")
}

model Company {
  id             String   @id @default(uuid())
  name           String
  cuit           String?
  address        String?
  city           String?
  phone          String?
  email          String?
  taxCondition   String   @default("RESPONSABLE_INSCRIPTO")
  grossIncome    String?  // Nro. de Ingresos Brutos — fallback de afip_config.grossIncome
  isActive       Boolean  @default(true)
  logoUrl        String?
  enabledModules String   @default("ALL") // "ALL" or comma-separated: "ventas,catalogo,compras,finanzas"
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("companies")
}

// ── Orden de Pago (supplier payments) ──────────────────────────────────────

model OrdenPago {
  id             String    @id @default(uuid())
  number         String
  supplierId     String
  userId         String
  cashRegisterId String?
  companyId      String    @default("00000000-0000-0000-0000-000000000001")
  date           DateTime  @default(now())
  amount         Decimal   @db.Decimal(12, 2)
  currency       String    @default("ARS")
  exchangeRate   Decimal   @default(1) @db.Decimal(12, 6)
  paymentMethod  String
  reference      String?
  bank           String?
  checkDueDate   DateTime?
  notes          String?
  status         String    @default("EMITTED") // EMITTED | CANCELLED
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  // Total retenido. `amount` es el BRUTO imputado a las facturas / cuenta
  // corriente; el egreso real de caja o banco es `amount - retentionAmount`.
  retentionAmount Decimal @default(0) @db.Decimal(12, 2)

  supplier                 Supplier                  @relation(fields: [supplierId], references: [id])
  user                     User                      @relation(fields: [userId], references: [id])
  cashRegister             CashRegister?             @relation(fields: [cashRegisterId], references: [id])
  items                    OrdenPagoItem[]
  ajustes                  OrdenPagoAjuste[]
  retenciones              OrdenPagoRetencion[]
  supplierAccountMovements SupplierAccountMovement[]

  fiscalMode String @default("FORMAL")

  @@unique([companyId, number])
  @@map("orden_pagos")
}

// Retención practicada al pagar. No reduce la deuda con el proveedor (la
// factura se cancela por el bruto): es un impuesto a depositar, y solo alimenta
// el reporte de retenciones y el asiento contable del pago.
model OrdenPagoRetencion {
  id                  String   @id @default(uuid())
  ordenPagoId         String
  supplierRetentionId String?
  type                String   @default("IIBB")
  jurisdiction        String?
  base                String   @default("NETO") // NETO | IVA | BRUTO
  baseAmount          Decimal  @default(0) @db.Decimal(14, 2)
  percentage          Decimal  @default(0) @db.Decimal(6, 3)
  amount              Decimal  @default(0) @db.Decimal(14, 2)
  arcaImpuesto        String? // código de impuesto SICORE (snapshot de la config)
  arcaRegimen         String? // código de régimen SICORE (snapshot de la config)
  certificate         String?
  notes               String?
  createdAt           DateTime @default(now())

  ordenPago         OrdenPago          @relation(fields: [ordenPagoId], references: [id], onDelete: Cascade)
  supplierRetention SupplierRetention? @relation(fields: [supplierRetentionId], references: [id], onDelete: SetNull)

  @@index([ordenPagoId])
  @@map("orden_pago_retenciones")
}

// Ajustes al pago (descuentos obtenidos, intereses, etc.). Cada uno referencia
// una cuenta del plan contable y suma (SUMA) o resta (RESTA) al total a pagar.
model OrdenPagoAjuste {
  id          String   @id @default(uuid())
  ordenPagoId String
  accountId   String?
  accountCode String?
  description String
  type        String   @default("RESTA") // SUMA | RESTA
  amount      Decimal  @db.Decimal(12, 2)
  createdAt   DateTime @default(now())

  ordenPago OrdenPago @relation(fields: [ordenPagoId], references: [id], onDelete: Cascade)

  @@index([ordenPagoId])
  @@map("orden_pago_ajustes")
}

model OrdenPagoItem {
  id                String  @id @default(uuid())
  ordenPagoId       String
  // Nullable en la DB desde que la factura de compra es documento de primer
  // nivel: un ítem puede imputarse a una purchase_invoice sin Compra asociada,
  // y una OP a cuenta no tiene ninguna de las dos.
  purchaseId        String?
  purchaseInvoiceId String?
  amount            Decimal @db.Decimal(12, 2)

  ordenPago       OrdenPago        @relation(fields: [ordenPagoId], references: [id], onDelete: Cascade)
  purchase        Purchase?        @relation(fields: [purchaseId], references: [id])
  purchaseInvoice PurchaseInvoice? @relation(fields: [purchaseInvoiceId], references: [id], onDelete: SetNull)

  @@map("orden_pago_items")
}

model SupplierAccountMovement {
  id                String   @id @default(uuid())
  supplierId        String
  ordenPagoId       String? // no @unique: una OP puede generar más de un movimiento (uno por moneda, ver pay())
  purchaseId        String?
  purchaseInvoiceId String? // set for retenciones/percepciones movements from a supplier invoice
  type              String // DEBIT | CREDIT
  amount            Decimal  @db.Decimal(12, 2)
  currency          String   @default("ARS")
  balance           Decimal  @default(0) @db.Decimal(12, 2) // running balance, escoped per (supplierId, currency)
  description       String?
  companyId         String   @default("00000000-0000-0000-0000-000000000001")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  supplier  Supplier   @relation(fields: [supplierId], references: [id])
  ordenPago OrdenPago? @relation(fields: [ordenPagoId], references: [id])
  purchase  Purchase?  @relation(fields: [purchaseId], references: [id])

  fiscalMode String @default("FORMAL")

  @@index([ordenPagoId])
  @@index([companyId, supplierId, currency], map: "idx_sam_company_supplier_currency")
  @@index([supplierId, createdAt(sort: Desc)], map: "idx_sam_supplier_created")
  @@map("supplier_account_movements")
}

// Imputación manual de cuenta corriente: cierra facturas/ND pendientes contra
// NC o pagos a cuenta sueltos sin pasar por una Orden de Pago. `manualAmount`
// es la diferencia (si la hay) que se condona/cierra a mano y que sí genera
// un movimiento nuevo en supplier_account_movements (ver PrismaOrdenPagoRepository).
// Acceso 100% vía $queryRaw/$executeRaw (igual que OrdenPagoAjuste) — no requiere
// regenerar el cliente Prisma.
model SupplierCcAdjustment {
  id           String   @id @default(uuid())
  supplierId   String
  companyId    String
  fiscalMode   String?
  currency     String   @default("ARS")
  manualAmount Decimal  @default(0) @db.Decimal(14, 2)
  description  String?
  userId       String
  createdAt    DateTime @default(now())

  items SupplierCcAdjustmentItem[]

  @@map("supplier_cc_adjustments")
}

model SupplierCcAdjustmentItem {
  id                String  @id @default(uuid())
  adjustmentId      String
  side              String // DEBIT | CREDIT
  purchaseInvoiceId String?
  movementId        String?
  amount            Decimal @db.Decimal(14, 2)

  adjustment SupplierCcAdjustment @relation(fields: [adjustmentId], references: [id], onDelete: Cascade)

  @@index([adjustmentId])
  @@map("supplier_cc_adjustment_items")
}

// ── Bancos (catálogo / parametrización) ─────────────────────────────────────

model Banco {
  id        String   @id @default(uuid())
  name      String
  code      String?
  sucursal  String?
  isActive  Boolean  @default(true)
  companyId String   @default("00000000-0000-0000-0000-000000000001")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@map("bancos")
}

// ── Tarjetas ────────────────────────────────────────────────────────────────

model Card {
  id        String   @id @default(uuid())
  name      String
  type      String   @default("CREDIT") // CREDIT | DEBIT
  bank      String?
  isActive  Boolean  @default(true)
  companyId String   @default("00000000-0000-0000-0000-000000000001")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  surcharges CardSurcharge[]
  recibos    Recibo[]

  @@map("cards")
}

model CardSurcharge {
  id               String   @id @default(uuid())
  cardId           String
  installments     Int      @default(1)
  surchargePercent Decimal  @db.Decimal(5, 2)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  card Card @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@unique([cardId, installments])
  @@map("card_surcharges")
}

// ── Banco (cuentas y movimientos bancarios) ─────────────────────────────────

model BankAccount {
  id            String         @id @default(uuid())
  name          String
  bank          String
  accountNumber String?
  currency      String         @default("ARS")
  balance       Decimal        @default(0) @db.Decimal(12, 2)
  companyId     String         @default("00000000-0000-0000-0000-000000000001")
  isActive      Boolean        @default(true)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  movements     BankMovement[]

  @@map("bank_accounts")
}

model BankMovement {
  id            String      @id @default(uuid())
  bankAccountId String
  type          String // CREDIT | DEBIT
  amount        Decimal     @db.Decimal(12, 2)
  description   String
  date          DateTime    @default(now())
  reciboId      String?     @unique
  ordenPagoId   String?     @unique
  companyId     String      @default("00000000-0000-0000-0000-000000000001")
  fiscalMode    String      @default("FORMAL")
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  bankAccount   BankAccount @relation(fields: [bankAccountId], references: [id])

  @@index([fiscalMode], map: "idx_bank_movements_fiscalMode")
  @@index([companyId, date(sort: Desc)], map: "idx_bank_movements_company_date")
  @@map("bank_movements")
}

model Cheque {
  id             String    @id @default(uuid())
  number         String
  type           String // INGRESO | EGRESO
  checkNumber    String? // N° del cheque físico
  bank           String?
  amount         Decimal   @db.Decimal(12, 2)
  currency       String    @default("ARS")
  exchangeRate   Decimal   @default(1) @db.Decimal(12, 4)
  dueDate        DateTime?
  issuer         String? // Librador (INGRESO)
  beneficiary    String? // Beneficiario (EGRESO)
  status         String    @default("PENDING") // PENDING | DEPOSITED | CLEARED | BOUNCED | RETURNED | ENDOSADO
  notes          String?
  customerId     String?
  supplierId     String?
  bankAccountId  String?
  cashRegisterId String?
  chequeraId     String?
  ordenPagoId    String? // OP a la que se entregó/endosó el cheque
  userId         String
  companyId      String    @default("00000000-0000-0000-0000-000000000001")
  fiscalMode     String    @default("FORMAL")
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([companyId, number])
  @@index([fiscalMode], map: "idx_cheques_fiscalMode")
  @@index([ordenPagoId], map: "idx_cheques_ordenPagoId")
  @@map("cheques")
}

model Chequera {
  id            String   @id @default(uuid())
  name          String?
  bank          String
  accountNumber String
  numberFrom    Int?
  numberTo      Int?
  nextNumber    Int?
  isActive      Boolean  @default(true)
  companyId     String   @default("00000000-0000-0000-0000-000000000001")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([companyId])
  @@map("chequeras")
}

/// Contador atómico de numeración de comprobantes, uno por (empresa, tipo, año).
/// Se incrementa con INSERT ... ON CONFLICT DO UPDATE ... RETURNING desde
/// `infrastructure/database/DocumentSequence.ts`; no la escribas a mano.
model DocumentSequence {
  id         String   @id @default(uuid())
  companyId  String
  docType    String
  year       Int
  nextNumber Int
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt

  @@unique([companyId, docType, year])
  @@map("document_sequences")
}
